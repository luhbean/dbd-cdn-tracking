      "text": "@#CHALLENGE_CompleteRoleChallengesKiller_TITLE",
      "textId": "CHALLENGE_CompleteRoleChallengesKiller_TITLE"
    },
    {
      "text": "You're a brutal, bloodthirsty Killer. The Entity is pleased.",
      "textId": "CHALLENGE_CompleteRoleChallengesKiller_DESC"
    },
    {
      "text": "Complete all Killer Quests",
      "textId": "CHALLENGE_CompleteRoleChallengesKiller_INFO"
    },
    {
      "text": "@#CHALLENGE_PlayAsSurvivor_TITLE",
      "textId": "CHALLENGE_PlayAsSurvivor_TITLE"
    },
