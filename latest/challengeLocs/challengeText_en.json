      "text": "@#CHALLENGE_HitDifferentSingleTrial_TITLE",
      "textId": "CHALLENGE_HitDifferentSingleTrial_TITLE"
    },
    {
      "text": "Killers' basic attacks aren't dependent on their power. They're a good way to down Survivors.",
      "textId": "CHALLENGE_HitDifferentSingleTrial_DESC"
    },
    {
      "text": "Hit {0} different Survivors with a basic attack in a single trial",
      "textId": "CHALLENGE_HitDifferentSingleTrial_INFO"
    },
